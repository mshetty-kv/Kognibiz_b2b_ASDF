/**
 * OfficeDepotBuyerUserProvisioner
 *
 * Canonical chain step 7b: external buyer User (BR-01).
 * PRECONDITION: OfficeDepotBuyerIdentitySeeder.execute() committed in a PRIOR transaction.
 * Traces to: FR-03 / US-03, EC-02.
 *
 * Deliberately a separate script from 50. User is a setup sObject; inserting it in the same
 * transaction as Account/Contact raises MIXED_DML_OPERATION. This split is the canonical
 * ordering fix (EC-02), not a shortcut.
 *
 * Profile resolution is dynamic and never hardcoded. Creating an Experience Cloud site from
 * the "Commerce Store (LWR)" template produces a profile named "<Site Name> Shopper Profile"
 * (verified pattern in org 00DgL00000L7NwjUAF: "Retail Supply Store Shopper Profile",
 * "RetailBuyerPortal Shopper Profile", "Kognivera Shopper Profile", "Commerce Store Shopper
 * Profile" - all UserLicense "External Apps Login", UserType CspLitePortal).
 * "Customer Community Login User" is the verified fallback actually used by the six working
 * buyer users currently in this org.
 *
 * This class performs NO permission set assignment - that is step 70, after the User exists.
 */
public with sharing class OfficeDepotBuyerUserProvisioner {
    /** Static entry point. Invoked by scripts/bash orchestration and re-runnable/idempotent. */
    public static void execute() {
        new OfficeDepotBuyerUserProvisioner().run();
    }

    private static final String ACCOUNT_NAME = 'Northwind Office Group';
    private static final String EMAIL_DOMAIN = '@officedepot.invalid';

    /**
     * The address Salesforce actually SENDS to for this user.
     *
     * The Contact carries a deliberately unroutable @...invalid address, and that address is
     * still used to derive the Username (which only has to be globally unique and e-mail
     * SHAPED, never deliverable). User.Email is different: on a first login from an unrecognised
     * browser Salesforce e-mails an identity-verification code there. With an undeliverable
     * address the code never arrives, the platform falls back to a security question that was
     * never configured, and the buyer is permanently locked out with no self-service recovery.
     * That failure mode was hit once on this project, so Email is pinned to a real mailbox.
     */
    private static final String NOTIFICATION_EMAIL = 'cthakur@kognivera.com';

    /**
     * Ordered preference. First match wins. Every name below was confirmed to exist in at least
     * one of the two target orgs - none are guessed.
     *
     * The two orgs differ sharply, which is exactly why this is resolved at runtime:
     *   Sandbox 00DgL00000L7NwjUAF  - has "Customer Community Login User" (used by six live
     *       buyers) and a per-store "<Store> Shopper Profile" generated by site creation.
     *   Scratch 00DG100000EKcgz     - site creation generated ONLY "Office Depot Profile" (Guest).
     *       No shopper profile at all, and no "Customer Community Login User". The available
     *       portal profiles are "Customer Community Plus User" and
     *       "B2B Reordering Portal Buyer Profile" (both Customer Community Plus /
     *       PowerCustomerSuccess), confirmed by SOQL on 2026-09-21.
     */
    private static final List<String> PROFILE_PREFERENCE = new List<String>{
        'Office Depot Shopper Profile',
        'Customer Community Login User',
        'Customer Community Plus Login User',
        'Customer Community Plus User',
        'B2B Reordering Portal Buyer Profile'
    };

    /**
     * Picks the highest-preference profile that BOTH exists AND has a free seat on its
     * UserLicense.
     *
     * Existence alone is not enough in a shared org. Target org 00DgL00000L7NwjUAF has
     * "Customer Community Login User" and "Customer Community Plus Login User" present, but
     * their licences are fully consumed by other people's portals (Customer Community Login
     * 5/5, Customer Community Plus Login 5/5, confirmed by SOQL on 2026-09-22). Selecting
     * either yields LICENSE_LIMIT_EXCEEDED at insert time - an error that names the licence,
     * not the profile, and so reads as unrelated to the choice made here.
     *
     * Checking UsedLicenses against TotalLicenses up front turns that into a decision rather
     * than a failure, and makes the class behave identically in a clean scratch org (where
     * every licence is empty and the first existing profile simply wins).
     */
    private Profile resolveBuyerProfile() {
        Map<String, Profile> byName = new Map<String, Profile>();
        Set<Id> licenseIds = new Set<Id>();
        for (Profile p : [
            SELECT Id, Name, UserType, UserLicenseId, UserLicense.Name
            FROM Profile WHERE Name IN :PROFILE_PREFERENCE WITH USER_MODE
        ]) {
            byName.put(p.Name, p);
            licenseIds.add(p.UserLicenseId);
        }

        Map<Id, UserLicense> licenses = new Map<Id, UserLicense>([
            SELECT Id, Name, Status, TotalLicenses, UsedLicenses
            FROM UserLicense WHERE Id IN :licenseIds WITH USER_MODE
        ]);

        List<String> rejected = new List<String>();
        for (String preferred : PROFILE_PREFERENCE) {
            Profile candidate = byName.get(preferred);
            if (candidate == null) {
                rejected.add(preferred + ' (profile absent)');
                continue;
            }
            UserLicense lic = licenses.get(candidate.UserLicenseId);
            if (lic == null) {
                rejected.add(preferred + ' (licence not visible)');
                continue;
            }
            if (lic.Status != null && lic.Status != 'Active') {
                rejected.add(preferred + ' (licence ' + lic.Name + ' is ' + lic.Status + ')');
                continue;
            }
            Integer total = lic.TotalLicenses == null ? 0 : lic.TotalLicenses;
            Integer used = lic.UsedLicenses == null ? 0 : lic.UsedLicenses;
            if (used >= total) {
                rejected.add(preferred + ' (licence ' + lic.Name + ' exhausted ' + used + '/' + total + ')');
                continue;
            }
            System.debug(LoggingLevel.INFO,
                'Resolved buyer profile: ' + preferred + ' (UserType=' + candidate.UserType +
                ', licence=' + lic.Name + ' ' + used + '/' + total + ' seats used)' +
                (rejected.isEmpty() ? '' : ' | skipped: ' + rejected));
            return candidate;
        }

        throw new CommerceAccessException(
            'No usable external buyer profile with a free licence seat. Evaluated in order: ' +
            rejected + '. Either free a community licence seat or confirm the site was created ' +
            'from the "Commerce Store (LWR)" template (which generates its own shopper profile ' +
            'on the "External Apps Login" licence).');
    }

    private List<Contact> loadBuyerContacts() {
        String emailLike = '%' + EMAIL_DOMAIN;
        List<Contact> contacts = [
            SELECT Id, FirstName, LastName, Email, AccountId
            FROM Contact
            WHERE Account.Name = :ACCOUNT_NAME AND Email LIKE :emailLike
            WITH USER_MODE
        ];
        if (contacts.isEmpty()) {
            throw new CommerceBusinessException(
                'EC-02 GUARD TRIPPED: no Contact exists under account "' + ACCOUNT_NAME + '". ' +
                'A User must never be created before its Contact and Account. ' +
                'Run OfficeDepotBuyerIdentitySeeder.execute() first and let it commit.');
        }
        return contacts;
    }

    /** One query for existing users, one insert for the delta. No DML in loops. */
    private void provision(List<Contact> contacts, Profile buyerProfile) {
        Set<Id> contactIds = new Set<Id>();
        for (Contact c : contacts) {
            contactIds.add(c.Id);
        }
        Set<Id> alreadyProvisioned = new Set<Id>();
        for (User u : [
            SELECT Id, ContactId FROM User WHERE ContactId IN :contactIds WITH USER_MODE
        ]) {
            alreadyProvisioned.add(u.ContactId);
        }

        String orgSuffix = '.' + UserInfo.getOrganizationId().substring(0, 8).toLowerCase();
        List<User> toInsert = new List<User>();
        for (Contact c : contacts) {
            if (alreadyProvisioned.contains(c.Id)) {
                System.debug(LoggingLevel.INFO, 'Buyer user already provisioned for contact ' + c.Id);
                continue;
            }
            String alias = c.FirstName.substring(0, 1).toLowerCase() +
                c.LastName.toLowerCase().left(6);
            toInsert.add(new User(
                ContactId = c.Id,
                ProfileId = buyerProfile.Id,
                FirstName = c.FirstName,
                LastName = c.LastName,
                // Deliverable mailbox, NOT the Contact's @...invalid address - see
                // NOTIFICATION_EMAIL. The Username still derives from the Contact email because
                // a username only needs to be unique and email-shaped.
                Email = NOTIFICATION_EMAIL,
                Username = c.Email + orgSuffix,
                Alias = alias.left(8),
                CommunityNickname = (c.FirstName + c.LastName).left(20),
                TimeZoneSidKey = 'America/Chicago',
                LocaleSidKey = 'en_US',
                EmailEncodingKey = 'UTF-8',
                LanguageLocaleKey = 'en_US',
                IsActive = true));
        }

        if (toInsert.isEmpty()) {
            System.debug(LoggingLevel.INFO, 'No new buyer users required.');
            return;
        }
        List<Database.SaveResult> results = Database.insert(toInsert, false, AccessLevel.USER_MODE);
        for (Integer i = 0; i < results.size(); i++) {
            if (results[i].isSuccess()) {
                System.debug(LoggingLevel.INFO, 'Buyer user created: ' + toInsert[i].Username);
            } else {
                System.debug(LoggingLevel.ERROR,
                    'Buyer user FAILED for ' + toInsert[i].Username + ' :: ' + results[i].getErrors() +
                    ' | Common causes: account owner has no UserRole; ' +
                    'the site is not yet Live; the profile has no available licence seats.');
            }
        }
    }

    public void run() {
        Profile buyerProfile = resolveBuyerProfile();
        List<Contact> contacts = loadBuyerContacts();
        provision(contacts, buyerProfile);
        System.debug(LoggingLevel.INFO,
            'Step 7b (Buyer Users) complete. Passwords are NOT set here - use ' +
            'sf org generate password or the Setup UI. Next: OfficeDepotStoreLinker.execute().');
    }
}
